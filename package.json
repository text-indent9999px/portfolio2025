    "next": "15.4.2",
    "react": "^0.0.0-experimental-6de32a5a-20250822",
    "react-dom": "^0.0.0-experimental-6de32a5a-20250822",
    "sass": "^1.89.2",
    "shiki": "^3.15.0",
    "tailwind-merge": "^3.5.0"
