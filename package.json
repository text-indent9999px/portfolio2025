    "ajv-keywords": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "eslint-plugin-storybook": "^9.1.10",
    "postcss": "^8.5.6",
    "storybook": "^9.1.10",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5"
